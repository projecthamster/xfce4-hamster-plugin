	"name": "xfce4-hamster-plugin",
	"image": "ghcr.io/projecthamster/xfce4-hamster-plugin-ci:sha-d34adde",

	"customizations": {
		"vscode": {
			"extensions": [
				"llvm-vs-code-extensions.vscode-clangd"
